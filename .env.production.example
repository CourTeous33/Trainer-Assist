# Copy to .env and fill in your values before running docker compose
DOMAIN=yourdomain.com
CORS_ORIGIN=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com

# Change these from defaults! Generate strong values with: openssl rand -hex 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=trainer_assist
REDIS_PASSWORD=change_me_to_a_strong_password
